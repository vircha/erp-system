# ---- ERP 服务 ----
PORT=3000
# 监听地址。生产环境建议保持 0.0.0.0 并由 nginx/Caddy 反代，或收窄到 127.0.0.1 只允许反代访问。
ERP_BIND=0.0.0.0

# HTTPS 证书路径（启用内置 TLS 时需要；走 nginx 反代则留空）
TLS_PORT=3443
ERP_TLS_KEY=
ERP_TLS_CRT=

# 允许的跨域来源，逗号分隔。留空 = 不额外放开。
ERP_CORS_ORIGINS=

# ---- 首次初始化的套账老板账号 ----
# ⚠️ 不设置时，源码会用内置默认账号 admin / admin123（方便克隆即可登录体验）。
#    服务启动时会打印醒目告警，运行中若admin 仍用该密码也会再次告警。
#    部署到公网前请务必设置这两个变量，或登录后到「设置」页改密码。
#    注意：这两个变量只在**首次建库**时生效；库已存在时改环境变量不会覆盖旧密码。
ERP_BOSS_USERNAME=
ERP_BOSS_PASSWORD=

# ---- 平台管理员（可选，逗号分隔）----
# is_admin=1 才能查看全平台用户 / 违规记录 / 执行封禁。默认为空 = 不授予任何账号。
ERP_ADMIN_ACCOUNTS=

# ---- 内容检测白名单（可选，逗号分隔）----
# 永久豁免内容检测与自动封禁，用于内部需要写敏感词的备注场景。
ERP_WHITELIST_ACCOUNTS=

# ---- 安全策略 ----
# 单 IP 登录失败次数上限与统计窗口（毫秒）
ERP_IP_FAIL_LIMIT=30
ERP_IP_FAIL_WINDOW=600000

# ---- 集成（可选）----
# 企业微信机器人通知
WECOM_WEBHOOK=
# Cloudflare R2 / 对象存储（APK 分发等）
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=