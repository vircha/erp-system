# ============================================================
# 复制本文件为 .env 后填写，然后运行 bash deploy.sh
#   cp .env.example .env && vi .env
# ============================================================

# ---- 部署必填三项 ----

#🔴 你的域名。必须是真实可解析到本服务器的域名，否则 HTTPS 证书申请会失败。
#    部署前请把域名的 A 记录指向服务器 IP，并等解析生效。
ERP_DOMAIN=erp.example.com

# Let's Encrypt 证书到期提醒邮箱（可留空）
ACME_EMAIL=

# 初始管理员账号。⚠️ 不要用 admin / admin123 —— deploy.sh 会直接拒绝部署。
#    注意：这两个变量只在**首次建库**时生效；库已存在时改它们不会覆盖旧密码，
#    需要登录后到「设置」页改，或用 bash deploy.sh restore 恢复备份。
ERP_BOSS_USERNAME=manager
ERP_BOSS_PASSWORD=请改成你自己的强密码

# ---- 以下一般不用改 ----

# ---- ERP 服务 ----
PORT=3000
# 容器内固定 0.0.0.0（由 Caddy 反代）。裸机部署才需要考虑收窄。
ERP_BIND=0.0.0.0

# HTTPS 证书路径（仅裸机部署 + 启用内置 TLS 时需要；走 Caddy 反代则留空）
TLS_PORT=3443
ERP_TLS_KEY=
ERP_TLS_CRT=

# 允许的跨域来源，逗号分隔。留空 = 不额外放开（同源）。
ERP_CORS_ORIGINS=

# ---- 平台管理员（可选，逗号分隔）----
# is_admin=1 才能查看全平台用户 / 违规记录 / 执行封禁。默认为空 = 不授予任何账号。
ERP_ADMIN_ACCOUNTS=

# ---- 内容检测白名单（可选，逗号分隔）----
# 永久豁免内容检测与自动封禁，用于内部需要写敏感词的备注场景。
ERP_WHITELIST_ACCOUNTS=

# ---- 安全策略 ----
# 单 IP 登录失败次数上限与统计窗口（毫秒）
ERP_IP_FAIL_LIMIT=30
ERP_IP_FAIL_WINDOW=600000

# ---- 集成（可选）----
# 企业微信机器人通知
WECOM_WEBHOOK=
# Cloudflare R2 / 对象存储（APK 分发等）
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE=