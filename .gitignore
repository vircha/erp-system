# ---- 依赖 ----
node_modules/
npm-debug.log*
package-lock.json.bak

# ---- 数据库（运行时生成，绝不入库）----
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
# 🔴🔴 目录规则必须用前导 / 锚定到仓库根，否则会匹配任意层级。
#   写 `data/` 会连Android 源码包
#   `android-native/.../com/heping/erpnative/data/`（4 个 .kt）一起吞掉 ——
#   本机能编译通过，CI 检出后直接报「Unresolved reference」。
#   前导 / 表示「只匹配根目录下这一层」。
#
# 🔴🔴 另一条铁律：**本文件不支持行尾注释**。
#   写 `uploads/    # 意见反馈附件` 时，git 会把`# 意见反馈附件`
#   一起当成路径去匹配，规则直接失效（目录不再被忽略）。
#   注释必须独占一行。
/data/
/backup/
# deploy.sh backup 产出的数据库快照（含全部业务数据）
/backups/

# ---- 用户上传与本地证书 ----
# 意见反馈附件（锚定根目录，避免误伤同名子目录）
/uploads/
# 本地 TLS 证书（锚定根目录）
/tls/
*.pem
*.key
*.crt
*.p12
*.pfx

# ---- Android 签名（必须本地保管）----
*.jks
*.keystore
keystore.properties
# 🔴 注意：路径必须写成 android-native/。原来写 android/ 完全没生效，
#    .gradle/ 与 app/build/（含打进 APK 的真实域名 BuildConfig.java）差点被提交。
android-native/local.properties
android-native/.gradle/
android-native/app/build/
android-native/build/
*.apk
*.aab

# ---- 环境变量 ----
.env
.env.local
.env.*.local

# ---- 真实业务数据（商业敏感，一律不入库）----
*.xlsx
*.xls
price_*.json
table_data.json
_orderdata*.json

# ---- 部署 / 运维脚本（含服务器凭据，不应开源）----
deploy_*.py
publish_*.py
ssh*.py
refresh_apk_url.sh
backup_db.py
ocr.ps1

# ---- 测试与临时产物 ----
/_regress/
/_webtest/
/_tmp/
/_archive/
/ocr_prep/
_regress.js
_probe*.js
_test_*.js
_verify*.js
_qr*.js
*.log
*.out
# 🔴 截图类 png 一律忽略，但**必须放行站点自己的图标**，
#    否则 PWA / favicon 会整个丢失（页面图标 404）。
# 🔴🔴 2026-10-19补：同样要放行 **Android 应用图标**。
#    漏掉这条的后果是 GitHub Actions 构建失败：
#      AAPT: error: resource drawable/ic_launcher_background not found
#    ——本机有这些 png（构建能过），但没进仓库，CI 检出后就没有。
*.png
!public/img/*.png
!docs/**/*.png
!android-native/app/src/main/res/**/*.png

# ---- 编辑器 / 系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- 本地临时文件 ----
*.keep
*.orig
*.rej
